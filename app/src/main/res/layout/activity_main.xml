<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER EDITORIAL LUXURY ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_navy"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="44dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <!-- Barra superior: Monograma circular dorado + Tagline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#1AC5A880"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#66C5A880"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="@color/brand_gold"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.2"
                    android:text="PERFUMES, RESEÑAS Y COMPARATIVAS"
                    android:textColor="@color/brand_gold_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Etiqueta de sección: "— TU ACCESO" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="24dp"
                    android:layout_height="1.5dp"
                    android:background="@color/brand_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.18"
                    android:text="TU ACCESO"
                    android:textColor="@color/brand_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título Principal: Aromántica -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Aromántica"
                android:textColor="@color/white"
                android:textSize="34sp" />

            <!-- Subtítulo descriptivo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="Inicia sesión para ver tus reseñas, listas y comparativas olfativas."
                android:textColor="@color/brand_subtitle"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Línea divisoria dorada sutil bajo el Header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brand_gold" />

        <!-- ================= CUERPO DEL FORMULARIO ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <!-- Campo 1: Correo electrónico -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Correo electrónico"
                android:textColor="@color/brand_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etEmailLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="tu@correo.com"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/brand_placeholder"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Campo 2: Contraseña (con ícono de mostrar/ocultar nativo) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Contraseña"
                android:textColor="@color/brand_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/brand_muted"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordLogin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Introduce tu contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="40dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/brand_navy"
                        android:textColorHint="@color/brand_placeholder"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Enlace: ¿Olvidaste tu contraseña? -->
            <TextView
                android:id="@+id/tvOlvidastePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/brand_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Checkbox: Recordarme en este dispositivo -->
            <CheckBox
                android:id="@+id/cbRecordarme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:buttonTint="@color/brand_navy"
                android:minHeight="36dp"
                android:text="Recordarme en este dispositivo"
                android:textColor="@color/brand_muted"
                android:textSize="12sp" />

            <!-- Botón Primario: Iniciar sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Iniciar sesión   →"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="8dp"
                app:elevation="2dp" />

            <!-- Botón Secundario: Registrarse -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrRegistro"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Registrarse"
                android:textAllCaps="false"
                android:textColor="@color/brand_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_surface"
                app:cornerRadius="8dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp" />

            <!-- Enlace para el Actor Invitado (Usuario Casual) -->
            <TextView
                android:id="@+id/tvContinuarInvitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="Continuar como invitado →"
                android:textColor="@color/brand_muted"
                android:textSize="12sp" />

            <!-- Espaciador flexible para empujar el footer al fondo -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ================= FOOTER ================= -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:background="@color/brand_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Alta Perfumería © 2026 Aromántica. Todos los derechos reservados."
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>