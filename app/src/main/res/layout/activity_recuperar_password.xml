<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER EDITORIAL LUXURY (UNIFICADO) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_navy"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="44dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <!-- Barra superior: Monograma circular dorado + Tagline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#1AC5A880"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#66C5A880"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="@color/brand_gold"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.2"
                    android:text="PERFUMES, RESEÑAS Y COMPARATIVAS"
                    android:textColor="@color/brand_gold_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Etiqueta de sección: "— RECUPERAR ACCESO" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="24dp"
                    android:layout_height="1.5dp"
                    android:background="@color/brand_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.18"
                    android:text="RECUPERAR ACCESO"
                    android:textColor="@color/brand_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título Principal en 2 líneas como el diseño -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="2dp"
                android:text="¿Olvidaste tu\ncontraseña?"
                android:textColor="@color/white"
                android:textSize="32sp" />

            <!-- Subtítulo descriptivo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="Ingresa tu correo asociado para restablecer el acceso a tu cuenta."
                android:textColor="@color/brand_subtitle"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Línea divisoria dorada sutil bajo el Header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brand_gold" />

        <!-- ================= CUERPO DEL FORMULARIO ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <!-- Campo: Correo electrónico -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Correo electrónico"
                android:textColor="@color/brand_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etEmailRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="tu@correo.com"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/brand_navy"
                    android:textColorHint="@color/brand_placeholder"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Recuadro informativo con ícono de sobre dorado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Cuadro interior del ícono de correo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/brand_ivory"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/brand_border"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="✉"
                            android:textColor="@color/brand_gold"
                            android:textSize="16sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="Se enviará un correo con las instrucciones y el enlace para restablecer tu contraseña."
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Espaciador flexible para empujar los botones y el footer al fondo -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botón Primario: Enviar instrucciones -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Enviar instrucciones   →"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="8dp"
                app:elevation="2dp" />

            <!-- Botón Secundario: Volver -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverDesdeRecuperar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Volver"
                android:textAllCaps="false"
                android:textColor="@color/brand_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_surface"
                app:cornerRadius="8dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp" />

            <!-- ================= FOOTER UNIFICADO ================= -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:background="@color/brand_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Alta Perfumería © 2026 Aromántica. Todos los derechos reservados."
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>