<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ivory"
    android:orientation="vertical">

    <!-- ================= 1. TOP APP BAR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/brand_navy"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnMenuLateralPerfil"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/brand_ivory"
            android:textSize="20sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            app:cardBackgroundColor="#1AC5A880"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_gold"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/brand_gold"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.2"
            android:text="AROMÁNTICA"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHeaderPerfilActivo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#26C5A880"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_gold"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Perfil de usuario"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/brand_gold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DC5A880" />

    <!-- ================= 2. MAIN CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- ===== SECCIÓN 1: USER PROFILE HEADER ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreCompletoPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Nombre usuario"
                        android:textColor="@color/brand_navy"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUsernamePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="\@usuario"
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Botón Píldora Editar Perfil -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/brand_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/brand_gold"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✎"
                            android:textColor="@color/brand_gold"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Editar perfil"
                            android:textColor="@color/brand_navy"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2 Columnas: Avatar (96dp) + Metadatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Columna Izquierda: Avatar 96dp con badge verificado -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardBackgroundColor="#EAE4DC"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/brand_gold"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/ivAvatarPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Foto de perfil"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_navy" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Checkmark Verificado inferior derecho -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        app:cardBackgroundColor="@color/brand_navy"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="@color/brand_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Columna Derecha: Lista de Metadatos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            app:cardBackgroundColor="@color/brand_gold"
                            app:cardCornerRadius="3dp"
                            app:cardElevation="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Género: "
                            android:textColor="@color/brand_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGeneroPerfil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Masculino"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            app:cardBackgroundColor="@color/brand_gold"
                            app:cardCornerRadius="3dp"
                            app:cardElevation="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Edad: "
                            android:textColor="@color/brand_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEdadPerfil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24 años"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            app:cardBackgroundColor="@color/brand_gold"
                            app:cardCornerRadius="3dp"
                            app:cardElevation="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Usuario desde: "
                            android:textColor="@color/brand_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFechaRegistroPerfil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Noviembre 2026"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== SECCIÓN 2: BIOGRAFÍA ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.08"
                        android:text="BIOGRAFÍA"
                        android:textColor="@color/brand_gold"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBiografiaPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="Entusiasta de la alta perfumería y diseñador. Coleccionista apasionado por notas ambaradas, amaderadas y especias cálidas. Siempre en búsqueda de nuevas fragancias de autor."
                        android:textColor="@color/brand_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECCIÓN 3: PERFUMES EN MI COLECCIÓN ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Perfumes en mi colección"
                    android:textColor="@color/brand_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Pill Switcher Compacto -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#F4F3F1"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/brand_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnTabMiColeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@color/brand_navy"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:text="Mi colección (14)"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/btnTabDeseados"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="Deseados (8)"
                            android:textColor="@color/brand_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Contenedor de 3 Columnas Iguales -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F4F3F1"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:weightSum="3">

                    <!-- Perfume 1: Gris Charnel -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardColeccionItem1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/brand_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/brand_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:layout_marginBottom="8dp"
                                app:cardBackgroundColor="@color/brand_ivory"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#F0EFEA"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/ivColeccionItem1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Gris Charnel"
                                    android:padding="12dp"
                                    android:scaleType="fitCenter"
                                    android:src="@android:drawable/ic_menu_gallery"
                                    app:tint="@color/brand_gold_dark" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreColeccion1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Gris Charnel"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="BDK Parfums"
                                android:textColor="@color/brand_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Perfume 2: Hawas for Him -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardColeccionItem2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/brand_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/brand_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:layout_marginBottom="8dp"
                                app:cardBackgroundColor="@color/brand_ivory"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#F0EFEA"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/ivColeccionItem2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Hawas for Him"
                                    android:padding="12dp"
                                    android:scaleType="fitCenter"
                                    android:src="@android:drawable/ic_menu_gallery"
                                    app:tint="@color/brand_gold_dark" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreColeccion2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Hawas for Him"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Rasasi"
                                android:textColor="@color/brand_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Perfume 3: Milestone -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardColeccionItem3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/brand_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/brand_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:layout_marginBottom="8dp"
                                app:cardBackgroundColor="@color/brand_ivory"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#F0EFEA"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/ivColeccionItem3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Milestone"
                                    android:padding="12dp"
                                    android:scaleType="fitCenter"
                                    android:src="@android:drawable/ic_menu_gallery"
                                    app:tint="@color/brand_gold_dark" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreColeccion3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Milestone"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Armaf"
                                android:textColor="@color/brand_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECCIÓN 4: MIS RESEÑAS (CON LISTVIEW Y CUSTOM ADAPTER) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Mis reseñas"
                    android:textColor="@color/brand_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContadorMisResenas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="(24)"
                    android:textColor="@color/brand_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ListView oficial que carga el diseño personalizado item_mi_resena.xml -->
            <ListView
                android:id="@+id/lvMisResenasPerfil"
                android:layout_width="match_parent"
                android:layout_height="265dp"
                android:layout_marginBottom="24dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:nestedScrollingEnabled="true"
                tools:listitem="@layout/item_mi_resena" />

            <!-- ===== SECCIÓN 5: MIS SUGERENCIAS ENVIADAS ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:text="Mis sugerencias enviadas"
                android:textColor="@color/brand_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiSugerencia1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTituloMiSugerencia1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nota olfativa: Yuzu japonés"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#26C5A880"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#66C5A880"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/tvEstadoMiSugerencia1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="✓ Estado: Aprobado"
                                android:textColor="@color/brand_navy"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvObservacionAdminSugerencia1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Observación Admin: Incorporada exitosamente al catálogo técnico de acordes cítricos."
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECCIÓN 6: BOTÓN CERRAR SESIÓN ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="⎋   Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#B91C1C"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_surface"
                app:cornerRadius="21dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ================= 3. BOTTOM NAVIGATION BAR ================= -->
